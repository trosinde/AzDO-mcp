<Window x:Class="AzdoMcp.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AzdoMcp.Manager.Core.ViewModels;assembly=AzdoMcp.Manager.Core"
        xmlns:v="clr-namespace:AzdoMcp.Manager.Views"
        Title="AzDO MCP Manager" Width="1120" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><v:OverviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionsViewModel}"><v:ConnectionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientsViewModel}"><v:ClientsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PermissionsViewModel}"><v:PermissionsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}"><v:ProjectDiscoveryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectRescanViewModel}"><v:ProjectRescanView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="8,6,8,12">
            <StackPanel DockPanel.Dock="Bottom" Margin="12,10">
                <TextBlock Text="{Binding FooterInstall}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                <TextBlock Text="{Binding FooterVersion}" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"
                           Visibility="{Binding CanUpdate, Converter={StaticResource InvBoolToVis}}" />
                <Button Style="{StaticResource Link}" Content="{Binding FooterVersion}" FontSize="12" Margin="0,3,0,0" HorizontalAlignment="Left"
                        Command="{Binding UpdateCommand}" ToolTip="Jetzt aktualisieren"
                        Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <ListBox x:Name="Nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding Current, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Navigation">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" FontSize="16" Width="16" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="home"><Setter Property="Text" Value="&#xE80F;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="key"><Setter Property="Text" Value="&#xE8D7;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="monitor"><Setter Property="Text" Value="&#xE7F4;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="shield"><Setter Property="Text" Value="&#xEA18;" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Icon}" Value="list"><Setter Property="Text" Value="&#xE8FD;" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Content -->
        <Border Grid.Column="1" Background="{StaticResource ContentBg}" BorderBrush="{StaticResource CardBorder}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl Content="{Binding Page}" Focusable="False" />
        </Border>
    </Grid>
</Window>
