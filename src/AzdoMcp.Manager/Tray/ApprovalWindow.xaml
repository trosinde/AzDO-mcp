<Window x:Class="AzdoMcp.Manager.Tray.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Freigabe anfordern" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <Style x:Key="ToastBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <Border Margin="10" Background="#F9F9F9" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="8" Padding="16,14"
            AutomationProperties.Name="Freigabe anfordern">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <TextBlock DockPanel.Dock="Right" x:Name="Remaining" FontSize="12" Foreground="{StaticResource WarnFg}" />
                <Image x:Name="AppIcon" Width="14" Height="14" Margin="0,0,8,0" />
                <TextBlock Text="AzDO MCP Manager · jetzt" FontSize="12" Foreground="{StaticResource TextMuted}" />
            </DockPanel>
            <TextBlock x:Name="TitleText" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="SummaryText" FontSize="13" Foreground="#333333" TextWrapping="Wrap" Margin="0,4,0,12" />
            <UniformGrid Columns="3">
                <Button Style="{StaticResource BtnPrimary}" Content="Erlauben" Margin="0,0,8,0" Click="OnApprove" IsDefault="True" />
                <Button Style="{StaticResource ToastBtn}" Content="Ablehnen" Click="OnDeny" />
                <Button Style="{StaticResource Btn}" Content="Details" Click="OnDetails" />
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
