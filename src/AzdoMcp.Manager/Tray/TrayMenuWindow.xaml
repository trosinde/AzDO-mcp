<Window x:Class="AzdoMcp.Manager.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AzDO MCP Manager – Menü" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True" FontFamily="{StaticResource UiFont}"
        Deactivated="OnDeactivated" KeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="Mi" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#0D000000" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="Background" Value="#0D000000" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Sep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource CardBorder}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </Window.Resources>

    <Border Margin="10" Background="#F9F9F9" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="8" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" />
        </Border.Effect>
        <StackPanel AutomationProperties.Name="Tray-Menü">
            <StackPanel Margin="12,10,12,8">
                <TextBlock Text="AzDO MCP Manager" FontSize="14" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse Width="8" Height="8" Fill="{Binding OverallLevel, Converter={StaticResource LevelDot}}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TrayStatus}" FontSize="12" Foreground="{StaticResource OkFg}" />
                </StackPanel>
            </StackPanel>
            <Border Style="{StaticResource Sep}" />
            <ItemsControl ItemsSource="{Binding TrayConnections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Mi}" Click="OnConnection" Tag="{Binding Id}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Level, Converter={StaticResource LevelDot}}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Mi}" Click="OnOpen"><TextBlock Text="Verwaltung öffnen" FontWeight="SemiBold" /></Button>
            <Button Style="{StaticResource Mi}" Click="OnApprovals"><TextBlock Text="{Binding PendingMenuText}" /></Button>
            <Button Style="{StaticResource Mi}" Click="OnRestart"><TextBlock Text="Server neu starten" /></Button>
            <Button Style="{StaticResource Mi}" Click="OnAutostart">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="✓" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                               Visibility="{Binding Autostart, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" />
                    <TextBlock Text="Autostart bei Anmeldung" />
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Mi}" Click="OnLogFolder"><TextBlock Text="Protokollordner öffnen" /></Button>
            <Border Style="{StaticResource Sep}" />
            <Button Style="{StaticResource Mi}" Click="OnExit"><TextBlock Text="Beenden" /></Button>
        </StackPanel>
    </Border>
</Window>
