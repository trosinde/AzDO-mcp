<UserControl x:Class="AzdoMcp.Manager.Views.ProjectRescanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="GroupHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,18,28,16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Btn}" Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource BtnPrimary}" Content="Änderungen übernehmen" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <StackPanel>
                <Button Style="{StaticResource Link}" Content="← Verbindungen" Command="{Binding CancelCommand}" HorizontalAlignment="Left" FontSize="12.5" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="26" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" />
                <TextBlock Text="Bitte warten – Azure DevOps wird abgefragt …" Style="{StaticResource Muted}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrFg}" FontSize="13" TextWrapping="Wrap" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="{Binding ApplyNoteText}" FontSize="12.5" TextWrapping="Wrap" Foreground="#333333" />
            <TextBlock Text="¹ Je Bereich Lesen | Schreiben: Grün = ja · Rot = nein · Grau = n/a (nicht prüfbar ohne echtes Schreiben) oder ? (noch nicht geprüft). ² Effektives Recht = PAT-Scope kombiniert mit deinen Projektrechten in Azure DevOps; nur „nein“ sperrt, Einstellungen unter «Tools &amp; Rechte» können es weiter einschränken. Durchgestrichen = Projekt nicht mehr sichtbar, Einstellungen bleiben erhalten."
                       FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- + Neu sichtbar -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupHead}"><Run Text="+ " Foreground="{StaticResource OkFg}" /><Run Text="{Binding NewRows.Count, Mode=OneWay}" /><Run Text=" Neu sichtbar – Häkchen = einrichten" /></TextBlock>
                        <DockPanel Margin="0,0,0,2">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewRows.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <ContentControl DockPanel.Dock="Right" ContentTemplate="{StaticResource RightsHeader}" Content="{Binding}" Focusable="False" />
                            <TextBlock />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding NewRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}" />
                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Rights}" VerticalAlignment="Center"
                                                      ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource RightsCompactItem}" />
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- − Nicht mehr sichtbar -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupHead}"><Run Text="− " Foreground="{StaticResource ErrFg}" /><Run Text="{Binding MissingRows.Count, Mode=OneWay}" /><Run Text=" Nicht mehr sichtbar – bleibt eingerichtet, wird nicht gelöscht" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding MissingRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,4">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Entfernen …" Foreground="{StaticResource ErrFg}" Height="28"
                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Alias}" FontSize="13.5" FontWeight="SemiBold" TextDecorations="Strikethrough" Foreground="{StaticResource ErrFg}" />
                                            <TextBlock Text="{Binding DataContext.MissingNoteText, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ≠ Rechte geändert -->
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GroupHead}"><Run Text="≠ " Foreground="{StaticResource WarnFg}" /><Run Text="{Binding ChangedRows.Count, Mode=OneWay}" /><Run Text=" Rechte geändert (alt → neu)" /><Run Text=" – nur Wechsel von oder zu „nein“" FontWeight="Normal" Foreground="{StaticResource TextMuted}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding ChangedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                        <ItemsControl ItemsSource="{Binding Changes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Area, StringFormat={}{0}:}" Width="150" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                                        <ContentPresenter Content="{Binding Old}" />
                                                        <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center" />
                                                        <ContentPresenter Content="{Binding New}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" Visibility="{Binding Note, Converter={StaticResource NullToVis}}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding UnchangedText}" Style="{StaticResource Muted}" Visibility="{Binding UnchangedText, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
