<UserControl x:Class="AzdoMcp.Manager.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="clr-namespace:AzdoMcp.Manager.Core.ViewModels;assembly=AzdoMcp.Manager.Core">
    <DockPanel Margin="28,22,28,22">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="200" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" AutomationProperties.Name="Suchen" />
                    <TextBlock Text="Tool, Work-Item-ID …" IsHitTestVisible="False" Margin="10,0" VerticalAlignment="Center" Foreground="#8A8A8A" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ComboBox Width="170" Height="32" FontSize="14" Margin="0,0,8,0" ItemsSource="{Binding ConnectionFilters}" SelectedItem="{Binding ConnectionFilter}" AutomationProperties.Name="Verbindung" />
                <ComboBox Width="170" Height="32" FontSize="14" Margin="0,0,8,0" ItemsSource="{x:Static vmc:LogViewModel.ResultFilters}" SelectedItem="{Binding ResultFilter}" AutomationProperties.Name="Ergebnis" />
                <Button Style="{StaticResource Btn}" Content="Exportieren" Command="{Binding ExportCommand}" />
            </StackPanel>
            <TextBlock Text="Protokoll" Style="{StaticResource H1}" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" AutomationProperties.Name="Aufrufe">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowBackground="Transparent"
                          SelectionMode="Single" CanUserResizeRows="False" RowHeight="40" FontSize="13.5" Margin="0,2,0,0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource Text}" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E5EEF8" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F5F5" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Zeit" Binding="{Binding Time}" Width="76" />
                        <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="104" />
                        <DataGridTemplateColumn Header="Tool" Width="*" MinWidth="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Text="{Binding Tool}" Style="{StaticResource Mono}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Verb." Binding="{Binding Connection}" Width="72" />
                        <DataGridTextColumn Header="Dauer" Binding="{Binding Duration}" Width="58" />
                        <DataGridTemplateColumn Header="Ergebnis" Width="SizeToCells" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><ContentPresenter Content="{Binding Result}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" AutomationProperties.Name="Details">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding PrivacyText}" Style="{StaticResource Hint}" />
                    <Grid>
                        <TextBlock Text="Keine offene Freigabe." Style="{StaticResource Muted}" Visibility="{Binding HasApproval, Converter={StaticResource InvBoolToVis}}" />
                        <StackPanel Visibility="{Binding HasApproval, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" CornerRadius="11" Height="22" Padding="9,0" Background="{StaticResource WarnBg}">
                                    <TextBlock Text="{Binding Remaining}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource WarnFg}" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Freigabe nötig" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock Text="{Binding ApprovalClient}" Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ApprovalHeadline}" FontSize="13.5" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="Änderung" Style="{StaticResource Label}" />
                            <Border Background="#F6F6F6" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                                <TextBlock Text="{Binding ApprovalChange}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                            </Border>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource BtnPrimary}" Content="Erlauben" Command="{Binding ApproveCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource Btn}" Content="Ablehnen" Command="{Binding DenyCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
