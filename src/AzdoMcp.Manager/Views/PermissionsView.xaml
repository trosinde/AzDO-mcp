<UserControl x:Class="AzdoMcp.Manager.Views.PermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,18,28,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Speichern" Command="{Binding SaveCommand}" VerticalAlignment="Bottom" />
            <StackPanel>
                <TextBlock Text="Tools &amp; Rechte" Style="{StaticResource H1}" FontSize="26" />
                <TextBlock Text="{Binding SubtitleText}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap">
                <Run Text="¹ " /><Run Text="Erlaubt" FontWeight="Bold" Foreground="{StaticResource OkFg}" /><Run Text=" = KI führt sofort aus · " /><Run Text="Nachfragen" FontWeight="Bold" Foreground="{StaticResource WarnFg}" /><Run Text=" = Freigabe-Fenster mit Erlauben/Ablehnen, ohne Antwort nach 2 min abgelehnt · " /><Run Text="Gesperrt" FontWeight="Bold" Foreground="{StaticResource ErrFg}" /><Run Text=" = Tool wird nicht angeboten. Blasser Modus = geerbt von der Ebene darüber." />
            </TextBlock>
            <TextBlock Text="{Binding Footnote2Text, StringFormat=² {0}}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Footnote3Text, StringFormat=³ {0}}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <Border Style="{StaticResource Card}" AutomationProperties.Name="Rechte-Hierarchie">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="236" />
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Ebene" Style="{StaticResource TableHeader}" Margin="12,7" />
                    <TextBlock Grid.Column="1" Text="Modus¹" Style="{StaticResource TableHeader}" Margin="12,7" />
                    <TextBlock Grid.Column="2" Text="Effektives Recht²" Style="{StaticResource TableHeader}" Margin="12,7" />
                    <TextBlock Grid.Column="3" Text="Hinweis" Style="{StaticResource TableHeader}" Margin="12,7" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorder}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="row" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" MinHeight="34" Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="236" />
                                            <ColumnDefinition Width="148" />
                                            <ColumnDefinition Width="210" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="{Binding IndentWidth, Converter={StaticResource Indent}}" VerticalAlignment="Center">
                                            <Button Width="22" Height="22" Margin="8,0,2,0" Command="{Binding ToggleCommand}" Content="{Binding ExpanderGlyph}"
                                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" Cursor="Hand"
                                                    AutomationProperties.Name="Auf- oder zuklappen">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button"><TextBlock Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Text="{Binding LevelText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="title" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" Margin="5,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,4" VerticalAlignment="Center">
                                            <Border BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="4" ClipToBounds="True"
                                                    Opacity="{Binding IsInherited, Converter={StaticResource InheritedOpacity}}" AutomationProperties.Name="{Binding Title, StringFormat=Modus {0}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource SegAllowed}" Content="Erlaubt" IsChecked="{Binding IsAllowed, Mode=TwoWay}" Height="24" Padding="8,0" FontSize="12.5" />
                                                    <RadioButton Style="{StaticResource SegAsk}" Content="Nachfragen" IsChecked="{Binding IsAsk, Mode=TwoWay}" Height="24" Padding="8,0" FontSize="12.5" />
                                                    <RadioButton Style="{StaticResource SegBlocked}" Content="Gesperrt" IsChecked="{Binding IsBlocked, Mode=TwoWay}" Height="24" Padding="8,0" FontSize="12.5" />
                                                </StackPanel>
                                            </Border>
                                            <Button Style="{StaticResource Link}" Content="↺" FontSize="13" Margin="8,0,0,0" ToolTip="Ausnahme entfernen (wieder erben)"
                                                    Command="{Binding ResetCommand}" Visibility="{Binding IsInherited, Converter={StaticResource InvBoolToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RightText}" Style="{StaticResource Hint}" Margin="0,0,5,0" VerticalAlignment="Center"
                                                       Visibility="{Binding RightText, Converter={StaticResource NullToVis}}" />
                                            <ContentPresenter Content="{Binding Right}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" Margin="12,4" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock x:Name="hint" Text="{Binding Hint}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                            <CheckBox Content="Schreibschalter" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowWriteSwitch, Converter={StaticResource BoolToVis}}"
                                                      IsChecked="{Binding WriteSwitch.AllowWrite}" IsEnabled="{Binding WriteSwitch.CanWrite}"
                                                      ToolTip="Aus = Schreib-Tools für dieses Projekt gesperrt" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Group">
                                        <Setter TargetName="title" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Tool">
                                        <Setter TargetName="row" Property="Background" Value="#FAFAFA" />
                                        <Setter TargetName="title" Property="FontFamily" Value="{StaticResource MonoFont}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Connection">
                                        <Setter TargetName="row" Property="Background" Value="#F4F7FB" />
                                        <Setter TargetName="title" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Project">
                                        <Setter TargetName="row" Property="Background" Value="#F8FAFD" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HintIsException}" Value="True">
                                        <Setter TargetName="hint" Property="Foreground" Value="{StaticResource OkFg}" />
                                        <Setter TargetName="hint" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</UserControl>
