<UserControl x:Class="AzdoMcp.Manager.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24">
            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn}" Content="Neu starten" Command="{Binding RestartCommand}" Margin="0,0,8,0"
                            ToolTip="Alle laufenden Server lesen Verbindungen und Rechte neu ein" />
                    <Button Style="{StaticResource Btn}" Content="{Binding PauseButtonText}" Command="{Binding PauseCommand}" Margin="0,0,8,0"
                            ToolTip="Stoppen: jeder Tool-Aufruf wird abgelehnt, bis „Fortsetzen“" />
                    <Button Style="{StaticResource BtnPrimary}" Content="+ Verbindung" Command="{Binding AddConnectionCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Übersicht" Style="{StaticResource H1}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ContentPresenter Content="{Binding ServerPill}" ToolTip="{Binding ServerToolTip}" />
                        <TextBlock Text="{Binding ServerDetail}" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Migration banner -->
            <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="6" Background="#FDE7E9" BorderBrush="#F1BBBF" BorderThickness="1"
                    Visibility="{Binding ShowLegacyBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="&#xE783;" FontSize="18" Foreground="#C42B1C" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="Später" Command="{Binding LaterCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource BtnDanger}" Content="Importieren" Command="{Binding ImportCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" FontSize="13.5" Foreground="#4A0E12" TextWrapping="Wrap">
                        <Run Text="{Binding LegacyText, Mode=OneWay}" FontWeight="Bold" /><Run Text=" in der alten " /><Run Text="config.json" FontFamily="{StaticResource MonoFont}" /><Run Text=". Importieren fasst sie pro Collection zusammen, speichert verschlüsselt (DPAPI) und löscht die Datei." />
                    </TextBlock>
                </DockPanel>
            </Border>

            <!-- Figures -->
            <UniformGrid Columns="4" Margin="-6,18,-6,0">
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Verbindungen" Style="{StaticResource Muted}" />
                        <TextBlock FontSize="26" FontWeight="SemiBold" Margin="0,4">
                            <Run Text="{Binding ConnectionCount, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding ProjectCountText, Mode=OneWay}" FontSize="14" FontWeight="Normal" Foreground="{StaticResource TextMuted}" />
                        </TextBlock>
                        <TextBlock Text="{Binding ConnectionsHint}" FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionsHintLevel}" Value="Warning"><Setter Property="Foreground" Value="{StaticResource WarnFg}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionsHintLevel}" Value="Error"><Setter Property="Foreground" Value="{StaticResource ErrFg}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Tool-Aufrufe heute" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding CallsToday}" FontSize="26" FontWeight="SemiBold" Margin="0,4" />
                        <TextBlock Text="{Binding WritesTodayText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Fehler (24 h)" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding Errors24h}" FontSize="26" FontWeight="SemiBold" Margin="0,4" />
                        <TextBlock Text="{Binding ErrorsHint}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Offene Freigaben" Style="{StaticResource Muted}" />
                        <TextBlock Text="{Binding PendingCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4" />
                        <Button Style="{StaticResource Link}" Content="{Binding PendingHint}" FontSize="12.5" HorizontalAlignment="Left"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="log" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Connections / projects + clients -->
            <Grid Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel Grid.IsSharedSizeScope="True">
                        <DockPanel Margin="14,12,14,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Verwalten"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="connections" />
                            <TextBlock Text="Verbindungen" Style="{StaticResource H2}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="oExp" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="oRight" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="oStat" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Verbindung / Projekt" Style="{StaticResource TableHeader}" />
                            <TextBlock Grid.Column="1" Text="PAT läuft ab" Style="{StaticResource TableHeader}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                <ContentControl ContentTemplate="{StaticResource RightsHeader}" Focusable="False" Content="{Binding}" />
                                <TextBlock Text="¹ ²" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource TableHeader}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource CardBorder}" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="row" BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="oExp" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="oRight" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="oStat" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="title" Grid.Column="0" Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="name" Text="{Binding Title}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{StaticResource TextMuted}" Margin="5,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToVis}}" />
                                                <Border Margin="6,0,0,0" CornerRadius="9" Height="18" Padding="7,0" Background="{StaticResource NeutralBg}"
                                                        Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Standard" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralFg}" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                            <ContentPresenter Grid.Column="1" Content="{Binding Expiry}" Margin="8,0" />
                                            <Grid Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding Rights}" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource RightsCompactItem}" />
                                                <Button x:Name="rescan" Style="{StaticResource Link}" Content="Neu einlesen" FontSize="12.5" Visibility="Collapsed"
                                                        Command="{Binding DataContext.RescanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </Grid>
                                            <Grid Grid.Column="3" Margin="8,0,14,0" VerticalAlignment="Center">
                                                <ContentPresenter Content="{Binding Status}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" MaxWidth="190" ToolTip="{Binding StatusTooltip}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProject}" Value="True">
                                            <Setter TargetName="row" Property="Background" Value="{StaticResource SubRowBg}" />
                                            <Setter TargetName="row" Property="Padding" Value="0,5" />
                                            <Setter TargetName="title" Property="Margin" Value="30,0,8,0" />
                                            <Setter TargetName="name" Property="FontWeight" Value="Normal" />
                                            <Setter TargetName="name" Property="FontSize" Value="13" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsProject}" Value="False">
                                            <Setter TargetName="rescan" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Noch keine Verbindung – „+ Verbindung“ richtet Collection, PAT und Projekte in einem Durchgang ein." Margin="14,12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Margin="14,8,14,10">
                            <TextBlock Text="{Binding Footnote1Text, StringFormat=¹ {0}}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Footnote2Text, StringFormat=² {0}}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12" VerticalAlignment="Top">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Link}" Content="Einbinden"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="clients" />
                            <TextBlock Text="Clients" Style="{StaticResource H2}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Clients}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,8,16,0">
                                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
