<UserControl x:Class="AzdoMcp.Manager.Views.ProjectDiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmc="clr-namespace:AzdoMcp.Manager.Core.ViewModels;assembly=AzdoMcp.Manager.Core">
    <UserControl.Resources>
        <Style x:Key="AccessCell" TargetType="ContentPresenter">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="28,18,28,16">
        <!-- Header with back link and step indicator -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Style="{StaticResource Link}" Content="← Verbindungen" Command="{Binding CancelCommand}" HorizontalAlignment="Left" FontSize="12.5" />
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="26" Margin="0,4,0,0" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,8,0,0" AutomationProperties.Name="Schritte">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="b" CornerRadius="11" Height="22" Padding="10,0" Margin="0,0,6,4" Background="{StaticResource NeutralBg}">
                            <TextBlock x:Name="t" Text="{Binding Title}" FontSize="12" Foreground="{StaticResource NeutralFg}" VerticalAlignment="Center" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource OkBg}" />
                                <Setter TargetName="t" Property="Foreground" Value="{StaticResource OkFg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="t" Property="Foreground" Value="White" />
                                <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer: message + buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn}" Content="Abbrechen" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn}" Content="Zurück" Command="{Binding BackCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource Btn}" Content="Übrige mit Voreinstellung" Command="{Binding SkipRestCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsProjectStep, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource BtnPrimary}" Content="{Binding NextText}" Command="{Binding NextCommand}"
                        Visibility="{Binding IsSummaryStep, Converter={StaticResource InvBoolToVis}}" />
                <Button Style="{StaticResource BtnPrimary}" Content="{Binding ApplyText}" Command="{Binding ApplyCommand}"
                        Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bitte warten – Azure DevOps wird abgefragt …" Style="{StaticResource Muted}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrFg}" FontSize="13" TextWrapping="Wrap" Visibility="{Binding Message, Converter={StaticResource NullToVis}}" />
            </StackPanel>
        </DockPanel>

        <Grid>
            <!-- ── Step 1: Verbindung ─────────────────────────── -->
            <Grid Visibility="{Binding IsConnectionStep, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="290" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <WrapPanel Margin="0,0,0,12" AutomationProperties.Name="Server-Typ">
                                <RadioButton Content="Azure DevOps Services" IsChecked="{Binding IsServices}" GroupName="wtyp" FontSize="14" Margin="0,0,22,4" />
                                <RadioButton Content="Azure DevOps Server (on-prem)" IsChecked="{Binding IsServer}" GroupName="wtyp" FontSize="14" Margin="0,0,0,4" />
                            </WrapPanel>
                            <TextBlock Text="Collection-URL" Style="{StaticResource Label}" />
                            <TextBox Style="{StaticResource Input}" FontFamily="{StaticResource MonoFont}" FontSize="13" Text="{Binding CollectionUrl, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Collection-URL" />
                            <TextBlock Text="z. B. https://dev.azure.com/&lt;Organisation&gt; oder https://&lt;server&gt;/&lt;Collection&gt;" Style="{StaticResource Hint}" Margin="0,5,0,12" />

                            <TextBlock Text="Personal Access Token" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="PAT erstellen ↗" Command="{Binding CreatePatCommand}" Margin="8,0,0,0" />
                                <PasswordBox x:Name="Pat" Height="32" FontSize="14" PasswordChanged="OnPatChanged" AutomationProperties.Name="Personal Access Token" />
                            </DockPanel>
                            <TextBlock Text="Ein PAT gilt für alle Projekte dieser Collection. Empfohlene Scopes: Work Items (Read &amp; write), Code (Read), Test Management (Read). Verschlüsselt mit Windows DPAPI."
                                       Style="{StaticResource Hint}" Margin="0,5,0,12" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PAT gültig bis" Style="{StaticResource Label}" />
                                    <DatePicker SelectedDate="{Binding PatExpires}" Height="32" FontSize="14" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Erinnerung" Style="{StaticResource Label}" />
                                    <ComboBox Height="32" FontSize="14" ItemsSource="{x:Static vmc:ConnectionsViewModel.ReminderOptions}" SelectedItem="{Binding Reminder}" DisplayMemberPath="Text" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Name der Verbindung" Style="{StaticResource Label}" />
                            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name der Verbindung" />
                            <TextBlock Text="Wird nach dem Test aus dem Servernamen vorgeschlagen." Style="{StaticResource Hint}" Margin="0,5,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="Verbindungstest" Style="{StaticResource H2}" Margin="0,0,0,8" />
                        <Button Style="{StaticResource BtnPrimary}" Content="Verbindung testen" Command="{Binding TestCommand}" HorizontalAlignment="Stretch" />
                        <TextBlock Text="{Binding LastTested}" Style="{StaticResource Hint}" Margin="0,6,0,2" />
                        <ItemsControl ItemsSource="{Binding TestResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" CornerRadius="11" Height="22" Padding="9,0" Margin="0,0,10,0" x:Name="pill" Background="{StaticResource NeutralBg}">
                                                <TextBlock Text="{Binding Code}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" x:Name="code" />
                                            </Border>
                                            <TextBlock Text="{Binding Text}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="Ok">
                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource OkBg}" />
                                            <Setter TargetName="code" Property="Foreground" Value="{StaticResource OkFg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource WarnBg}" />
                                            <Setter TargetName="code" Property="Foreground" Value="{StaticResource WarnFg}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                            <Setter TargetName="pill" Property="Background" Value="{StaticResource ErrBg}" />
                                            <Setter TargetName="code" Property="Foreground" Value="{StaticResource ErrFg}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="PAT-Scope (gilt für alle Projekte)" FontSize="13" FontWeight="Bold" Margin="0,12,0,6" />
                        <ContentControl Content="{Binding Scope}" ContentTemplate="{StaticResource RightsTable}" Focusable="False" />
                        <TextBlock Text="{Binding ScopeFootnoteText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Step 2: Projekte (artboard "Erkennung") ────── -->
            <DockPanel Visibility="{Binding IsProjectsStep, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="Alle auswählen" Command="{Binding SelectAllCommand}" Margin="0,0,8,0" />
                        <ComboBox Width="210" Height="32" FontSize="14" ItemsSource="{x:Static vmc:SetupWizardViewModel.Filters}" SelectedItem="{Binding Filter}" AutomationProperties.Name="Filter" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding DiscoverySummary}" Style="{StaticResource Muted}" />
                        <ItemsControl ItemsSource="{Binding DiscoveryNotes}">
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource WarnFg}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{Binding DefaultsHintText}" FontSize="12.5" TextWrapping="Wrap"><TextBlock.Foreground><SolidColorBrush Color="#333333" /></TextBlock.Foreground></TextBlock>
                    <TextBlock Text="Im nächsten Schritt gehst du jedes ausgewählte Projekt einzeln durch und kannst Kurzname, Schreibschalter und Modus je Tool-Gruppe setzen."
                               Style="{StaticResource Hint}" Margin="0,3,0,0" />
                    <TextBlock Text="¹ Je Bereich Lesen | Schreiben: Grün = ja · Rot = nein (Tools für diesen Bereich werden im Projekt gesperrt) · Grau = n/a (nicht prüfbar ohne echtes Schreiben) oder ? (noch nicht geprüft). WI = Work Items, Iter = Iterationen. ² Gezeigt wird das effektive Recht: PAT-Scope kombiniert mit deinen Projektrechten in Azure DevOps."
                               FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="170" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Auswahl" Style="{StaticResource TableHeader}" Margin="12,7" />
                            <TextBlock Grid.Column="1" Text="Projekt" Style="{StaticResource TableHeader}" Margin="12,7" />
                            <ContentControl Grid.Column="2" ContentTemplate="{StaticResource RightsHeader}" Content="{Binding}" Focusable="False" Margin="12,7" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="Status" Style="{StaticResource TableHeader}" Margin="12,7" />
                        </Grid>
                        <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorder}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" MinHeight="36">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="170" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0" Margin="14,0" VerticalAlignment="Center" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                                          AutomationProperties.Name="{Binding Name}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Rights}" Margin="12,0" VerticalAlignment="Center"
                                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource RightsCompactItem}" />
                                                <ContentPresenter Grid.Column="3" Content="{Binding Status}" Style="{StaticResource AccessCell}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DockPanel>

            <!-- ── Step 3..n: Projekt k von n ─────────────────── -->
            <Border Visibility="{Binding IsProjectStep, Converter={StaticResource BoolToVis}}">
            <Grid DataContext="{Binding CurrentSetup}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="20,16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="{Binding DataContext.StepTitle, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource H2}" FontSize="17" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Kurzname" Style="{StaticResource Label}" />
                                    <TextBox Style="{StaticResource Input}" Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Kurzname" CharacterCasing="Upper" MaxLength="10" />
                                    <TextBlock Text="{Binding AliasHint}" Style="{StaticResource Hint}" Margin="0,5,0,0" />
                                    <TextBlock Text="{x:Static vmc:ProjectSetup.RuleText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding AliasError}" FontSize="12" Foreground="{StaticResource ErrFg}" Visibility="{Binding AliasError, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Standardprojekt" IsChecked="{Binding IsDefault}" VerticalAlignment="Top" Margin="0,26,0,0" FontSize="13.5" />
                            </Grid>

                            <Border Padding="12,10" CornerRadius="6" Background="#F5F8FC" BorderBrush="#DCE6F2" BorderThickness="1" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding AllowWrite}" IsEnabled="{Binding CanWrite}" FontSize="13.5">
                                        <TextBlock><Run Text="Schreibschalter" FontWeight="Bold" /><Run Text=" – Schreib-Tools für dieses Projekt zulassen" Foreground="{StaticResource TextMuted}" FontSize="12" /></TextBlock>
                                    </CheckBox>
                                    <TextBlock Text="{Binding WriteHint}" Style="{StaticResource Hint}" Margin="26,3,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Modus je Tool-Gruppe" Style="{StaticResource Label}" />
                            <ItemsControl ItemsSource="{Binding Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" Padding="0,7">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LockReason}" FontSize="12" Foreground="{StaticResource ErrFg}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="{Binding LockReason, Converter={StaticResource NullToVis}}" />
                                                <Border DockPanel.Dock="Right" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="4" ClipToBounds="True" IsEnabled="{Binding IsEditable}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <RadioButton Style="{StaticResource SegAllowed}" Content="Erlaubt" IsChecked="{Binding IsAllowed, Mode=TwoWay}" />
                                                        <RadioButton Style="{StaticResource SegAsk}" Content="Nachfragen" IsChecked="{Binding IsAsk, Mode=TwoWay}" />
                                                        <RadioButton Style="{StaticResource SegBlocked}" Content="Gesperrt" IsChecked="{Binding IsBlocked, Mode=TwoWay}" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Feiner (pro Tool) unter «Tools &amp; Rechte». Voreinstellung: Lesen = Erlaubt · Schreiben = Nachfragen." Style="{StaticResource Hint}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" />
                        <TextBlock Text="Effektives Recht²" Style="{StaticResource Hint}" Margin="0,2,0,8" />
                        <ContentControl Content="{Binding Rights}" ContentTemplate="{StaticResource RightsTable}" Focusable="False" />
                        <TextBlock Text="PAT-Scope kombiniert mit deinen Projektrechten; nur „nein“ sperrt. n/a = nicht prüfbar ohne echtes Schreiben, ? = noch nicht geprüft. Ein Modus kann es nur einschränken." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
            </Border>

            <!-- ── Zusammenfassung ────────────────────────────── -->
            <Border Style="{StaticResource Card}" Visibility="{Binding IsSummaryStep, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Projekt" Style="{StaticResource TableHeader}" Margin="12,7" />
                        <TextBlock Grid.Column="1" Text="Kurzname" Style="{StaticResource TableHeader}" Margin="12,7" />
                        <ContentControl Grid.Column="2" ContentTemplate="{StaticResource RightsHeader}" Content="{Binding}" Focusable="False" Margin="12,7" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Schreibschalter" Style="{StaticResource TableHeader}" Margin="12,7" />
                        <TextBlock Grid.Column="4" Text="Geänderte Modi" Style="{StaticResource TableHeader}" Margin="12,7" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource CardBorder}" />
                    <TextBlock DockPanel.Dock="Bottom" Margin="14,10" Style="{StaticResource Hint}"
                               Text="«Übernehmen» speichert die Verbindung (PAT einmal, verschlüsselt), die Projekte und nur die Modi, die du gegenüber der Voreinstellung geändert hast. Laufende Server lesen danach neu ein." />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Keine neuen Projekte ausgewählt – es werden nur die Rechte der bestehenden Projekte aktualisiert." Margin="14,12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Setups.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Setups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource RowBorder}" BorderThickness="0,0,0,1" MinHeight="36">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                    <Border Margin="6,0,0,0" CornerRadius="9" Height="18" Padding="7,0" Background="{StaticResource NeutralBg}"
                                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Standard" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource NeutralFg}" VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Alias}" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Margin="12,0" VerticalAlignment="Center" />
                                                <ItemsControl Grid.Column="2" ItemsSource="{Binding Rights}" Margin="12,0" VerticalAlignment="Center"
                                                              ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource RightsCompactItem}" />
                                                <TextBlock Grid.Column="3" Margin="12,0" VerticalAlignment="Center" FontSize="13">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="aus" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AllowWrite}" Value="True"><Setter Property="Text" Value="an" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="4" Text="{Binding ModesSummary}" Style="{StaticResource Hint}" Margin="12,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
