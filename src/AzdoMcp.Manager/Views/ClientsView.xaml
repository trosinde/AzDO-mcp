<UserControl x:Class="AzdoMcp.Manager.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,22">
            <TextBlock Text="MCP-Clients einbinden" Style="{StaticResource H1}" />
            <TextBlock FontSize="13.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,16" TextWrapping="Wrap">
                <Run Text="Der Client startet " /><Run Text="{Binding ServerCommand, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text=". " /><Run Text="{Binding IntroText, Mode=OneWay}" />
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" Margin="-7,0" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="7" Padding="16,14" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <ContentPresenter DockPanel.Dock="Right" Content="{Binding Status}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarnFg}" FontSize="12.5" TextWrapping="Wrap" Margin="0,-4,0,8"
                                           Visibility="{Binding Warning, Converter={StaticResource NullToVis}}" />
                                <Border Background="#F6F6F6" CornerRadius="4" Padding="10,8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Snippet}" Style="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <ItemsControl ItemsSource="{Binding Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Text}" Command="{Binding Command}" Margin="0,0,8,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPrimary}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource Accent}" />
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Prompt kopieren" Command="{Binding CopyPromptCommand}"
                                                    AutomationProperties.Name="{Binding Name, StringFormat=Prompt kopieren {0}}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Prompt zum Einrichten" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Text="{Binding PromptTarget}" Style="{StaticResource Hint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Background="#F6F6F6" CornerRadius="4" Padding="10,8">
                                            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                                <TextBlock Text="{Binding Prompt}" FontSize="12" TextWrapping="Wrap" Foreground="#333333" />
                                            </ScrollViewer>
                                        </Border>
                                        <TextBlock Text="{Binding TestQuestion}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,7,0,0" AutomationProperties.Name="Hinweis">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Content="Pfad kopieren" Command="{Binding CopyPathCommand}" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock>
                            <Run Text="Programm" FontWeight="Bold" /><Run Text="  " /><Run Text="{Binding PathNoteText, Mode=OneWay}" Foreground="{StaticResource TextMuted}" FontSize="12" />
                        </TextBlock>
                        <TextBlock Text="{Binding ExeDisplayPath}" Style="{StaticResource Mono}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
